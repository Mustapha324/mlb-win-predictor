# Optional account URLs. Predictions work without these settings.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional live consensus + DFS board alignment. Player picks continue to work without this key.
# When set, player picks are also pinned to the actual PrizePicks/Underdog standard-payout
# boards via The Odds API us_dfs region (per-event player prop requests use paid credits).
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_REGIONS=us
# Set to "off" to keep the key for game odds but skip DFS board fetches.
DFS_BOARDS=off
# Cap on slate games fetched per sport for DFS boards (default 16).
DFS_BOARD_MAX_EVENTS=16

# Set to "off" to disable Game Brain adjustments. Default: on.
BRAIN=
